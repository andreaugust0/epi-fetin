# URL base da API de detecção de EPI.
# Enquanto estiver vazia, o aplicativo usa o MockEpiDetectionService.
# Ao preencher, o ApiEpiDetectionService passa a ser usado automaticamente.
EXPO_PUBLIC_EPI_API_URL=

# Timeout (ms) das requisições à API de detecção. Opcional.
EXPO_PUBLIC_EPI_API_TIMEOUT_MS=20000

# URL base do backend de identificação facial (POST /api/v1/identificacao).
# Não é segredo — só o token do dispositivo (JWT) é, e esse NUNCA vai em
# variável de ambiente: fica em SecureStore, ver deviceTokenStore.
EXPO_PUBLIC_FACE_API_URL=

# Ponto de acesso (ponto_id) onde este tablet está instalado. Inteiro positivo.
EXPO_PUBLIC_FACE_POINT_ID=
