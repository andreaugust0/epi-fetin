# ---------------------------------------------------------------- segredos
# O .env guarda JWT_SECRET, senha do banco e chaves do storage.
# NUNCA versione. O .env.example é o que vai para o repositório.
.env
.env.local
.env.*.local
*.pem
*.key
mosquitto/config/passwd
mosquitto/config/acl
mosquitto/config/certs/

# ------------------------------------------------------------------ esp32
# Build do PlatformIO e a configuracao local da placa — o config.h guarda a
# senha do Wi-Fi. O config.exemplo.h e que vai para o repositorio.
esp32/.pio/
esp32/src/config.h

# ---------------------------------------------------------------- python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------- dados
# Volumes e arquivos gerados em tempo de execução.
_evidencias/
mosquitto/data/
mosquitto/log/
pgdata/
miniodata/
*.sqlite
*.db

# Dump do banco. Carrega nome, setor, consentimento e o VETOR BIOMÉTRICO de
# cada pessoa — é o arquivo mais sensível que este projeto produz, e o que
# mais parece inofensivo por ser texto. Nenhum `.sql` é versionado aqui, então
# a regra larga não esconde nada de útil.
servidor/backups/
*.sql

# ---------------------------------------------------------------- editor
.vscode/
.idea/
*.swp
*.swo
*~

