# ---------------------------------------------------------------- app
APP_NAME="EPI Guard API"
ENV=dev
DEBUG=true

# ---------------------------------------------------------------- auth
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isto-por-um-segredo-de-pelo-menos-32-caracteres
JWT_EXPIRA_MIN=480

# ---------------------------------------------------------------- banco
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epi
DB_USER=postgres
DB_PASS=postgres
DB_ECHO=false

# ---------------------------------------------------------------- mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TLS=false
MQTT_CA_CERT=

# ------------------------------------------------------------ biometria
# PRECISA bater com o modelo que roda no tablet.
# FaceNet clássico = 128; InceptionResnetV1 (facenet-pytorch) e
# Facenet512 = 512.
FACE_EMBEDDING_DIM=512
FACE_MODELO=facenet512-v1

# Calibre com a SUA base (curva ROC / EER). O valor abaixo é ponto de
# partida, não verdade científica.
FACE_DISTANCIA_MAX=0.40
FACE_RAZAO_MIN=1.15
FACE_TOP_K=5
IDENTIFICACAO_TTL_S=60

# ---------------------------------------------------------------- fluxo
VERIFICACAO_TIMEOUT_S=10
VERIFICACAO_FRAMES=5
CATRACA_DURACAO_MS=5000

# -------------------------------------------------------------- storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=evidencias
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
EVIDENCIA_RETENCAO_DIAS=90
